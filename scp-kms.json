{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DenyS3BucketCreationWithoutEncryption",
            "Effect": "Deny",
            "Action": "s3:CreateBucket",
            "Resource": "*",
            "Condition": {
                "Null": {
                    "s3:x-amz-server-side-encryption": "true"
                }
            },
            "Comment": "1.Block bucket creation if no encryption specified"
        },
        {
            "Sid": "DenyS3BucketCreationWithoutKMS",
            "Effect": "Deny",
            "Action": "s3:CreateBucket",
            "Resource": "*",
            "Condition": {
                "StringNotEqualsIfExists": {
                    "s3:x-amz-server-side-encryption": "aws:kms"
                }
            },
            "Comment": "2.Require KMS encryption for new buckets"
        },
        {
            "Sid": "DenyS3BucketEncryptionChangesWithoutKMS",
            "Effect": "Deny",
            "Action": "s3:PutBucketEncryption",
            "Resource": "*",
            "Condition": {
                "StringNotEquals": {
                    "s3:x-amz-server-side-encryption": "aws:kms"
                }
            },
            "Comment": "3.Prevent changing encryption to non-KMS"
        },
        {
            "Sid": "DenyNonPrefixedKMSKeysForCreate",
            "Effect": "Deny",
            "Action": "s3:CreateBucket",
            "Resource": "*",
            "Condition": {
                "StringNotLikeIfExists": {
                    "s3:x-amz-server-side-encryption-aws-kms-key-id": "arn:aws:kms:*:*:key/iv-*"
                }
            },
            "Comment": "4.Require KMS keys with 'iv-' prefix for new buckets"
        },
        {
            "Sid": "DenyNonPrefixedKMSKeysForUpdates",
            "Effect": "Deny",
            "Action": "s3:PutBucketEncryption",
            "Resource": "*",
            "Condition": {
                "StringNotLikeIfExists": {
                    "s3:x-amz-server-side-encryption-aws-kms-key-id": "arn:aws:kms:*:*:key/iv-*"
                }
            },
            "Comment": "5.Require KMS keys with 'iv-' prefix for encryption changes"
        }
    ]
}